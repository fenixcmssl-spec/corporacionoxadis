// ============================================================================
// FENIXCMS SAAS — ESQUEMA DE DATOS POSTGRESQL (PRISMA ORM)
// FASE 1.2: MODELO DE DATOS INICIAL Y RELACIONES MULTITENANT
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS Y ESTADOS EXPLÍCITOS DE LA PLATAFORMA
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum UserType {
  SUPERADMIN
  TENANT_USER
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  UNPAID
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPENDED
}

enum ActivationStatus {
  ACTIVE
  REVOKED
  DEACTIVATED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SETTLED
  FAILED
  REFUNDED
  CHARGEBACK
}

enum PaymentGateway {
  STRIPE
  BIZUM
  BANK_TRANSFER
  INTERNAL_MANUAL
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SslStatus {
  PENDING
  ACTIVE
  FAILED
  REVOKED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  TENANT_CREATED
  TENANT_SUSPENDED
  TENANT_ACTIVATED
  PLAN_CREATED
  PLAN_UPDATED
  LICENSE_ISSUED
  LICENSE_REVOKED
  DOMAIN_LINKED
  DOMAIN_VERIFIED
  DOMAIN_REMOVED
  PAYMENT_PROCESSED
  PAYMENT_FAILED
  SECURITY_ALERT
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum PropertyOperation {
  SALE
  RENT
  TRANSFER
}

enum PropertyType {
  APARTMENT
  HOUSE
  CHALET
  ATTIC
  COMMERCIAL
  OFFICE
  LAND
  VILLA
  OTHER
}

enum AuctionStatus {
  DRAFT
  UPCOMING
  ACTIVE
  CLOSED
  AWARDED
  CANCELLED
}

enum AwardStatus {
  PENDING
  AWARDED
  REJECTED
  EXPIRED
}

enum ClassifiedCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  USED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  READ
  RESOLVED
  ARCHIVED
}

enum ReportTargetType {
  PRODUCT
  BLOG_POST
  PROPERTY
  AUCTION
  CLASSIFIED
  PERSONAL
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ============================================================================
// 1. GESTIÓN DE USUARIOS, SESIONES Y CONTROL DE ACCESO (RBAC)
// ============================================================================

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  fullName         String
  userType         UserType   @default(TENANT_USER)
  status           UserStatus @default(ACTIVE)
  tenantId         String?
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean    @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relaciones
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogsInitiated  AuditLog[]           @relation("AuditActor")

  @@index([tenantId])
  @@index([email])
  @@index([userType, status])
  @@map("users")
}

model Role {
  id           String   @id @default(cuid())
  name         String
  slug         String
  description  String?
  isSystemRole Boolean  @default(false)
  tenantId     String? // null = Rol Global de plataforma; not null = Rol específico del tenant
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // e.g. "tenants:manage", "domains:write", "billing:view"
  moduleSlug  String?
  description String?
  createdAt   DateTime @default(now())

  // Relaciones
  roles RolePermission[]

  @@index([moduleSlug])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // Relaciones
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
// 2. TENANTS (ORGANIZACIONES CLIENTES) Y MULTIDOMINIO
// ============================================================================

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique // Subdominio interno: e.g. "modaurbana" (.fenixcms.app)
  status    TenantStatus @default(TRIAL)
  planId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relaciones con política de conservación contable/auditoría
  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  users         User[]
  roles         Role[]
  domains       Domain[]
  licenses      License[]
  subscriptions Subscription[]
  payments      Payment[] // Borrado restringido: datos financieros protegidos
  auditLogs     AuditLog[] // Borrado conservado: auditoría protegida

  // Relaciones con los 6 módulos del CMS y modelos transversales
  productCategories ProductCategory[]
  products          Product[]
  storeOrders       StoreOrder[] // Borrado restringido para conservación contable
  blogCategories    BlogCategory[]
  blogPosts         BlogPost[]
  properties        RealEstateProperty[]
  auctions          AuctionItem[]
  classifiedAds     ClassifiedAd[]
  personalAds       PersonalAd[]
  cmsPages          CmsPage[]
  languages         Language[]
  plugins           TenantPlugin[]
  themes            TenantTheme[]
  contactInquiries  ContactInquiry[]
  contentReports    ContentReport[]

  @@index([slug])
  @@index([status])
  @@index([planId])
  @@map("tenants")
}

model Domain {
  id                 String                   @id @default(cuid())
  tenantId           String
  hostname           String                   @unique // e.g. "modaurbana-boutique.com"
  isPrimary          Boolean                  @default(false)
  verificationStatus DomainVerificationStatus @default(PENDING)
  verificationToken  String? // Token DNS TXT
  verifiedAt         DateTime?
  sslStatus          SslStatus                @default(PENDING)
  sslIssuedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Relaciones
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activations LicenseActivation[]

  @@index([tenantId])
  @@index([hostname])
  @@index([isPrimary])
  @@map("domains")
}

// ============================================================================
// 3. CATÁLOGO DE MÓDULOS, PLANES Y LÍMITES SAAS
// ============================================================================

model PlatformModule {
  id          String   @id @default(cuid())
  slug        String   @unique // "ecommerce", "multilanguage", "plugins_engine", "custom_domains", "api_access"
  name        String
  description String
  category    String // "CORE", "COMMERCE", "EXPANSION", "INTEGRATION"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relaciones
  planModules PlanModule[]

  @@index([slug])
  @@map("platform_modules")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // "starter", "pro", "enterprise"
  description  String
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal  @db.Decimal(10, 2)
  isPublic     Boolean  @default(true)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  tenants       Tenant[]
  subscriptions Subscription[]
  modules       PlanModule[]
  limits        PlanLimit[]

  @@index([slug])
  @@index([isActive])
  @@map("plans")
}

model PlanModule {
  id        String   @id @default(cuid())
  planId    String
  moduleId  String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relaciones
  plan   Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
  @@map("plan_modules")
}

model PlanLimit {
  id          String   @id @default(cuid())
  planId      String
  limitKey    String // "max_domains", "max_storage_mb", "max_products", "max_languages", "max_team_members"
  limitValue  Int // Cantidad permitida (-1 = ilimitado)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, limitKey])
  @@index([planId])
  @@map("plan_limits")
}

// ============================================================================
// 4. LICENCIAS CRIPTOGRÁFICAS Y ACTIVACIÓN DE DOMINIOS
// ============================================================================

model License {
  id               String        @id @default(cuid())
  licenseKey       String        @unique // Clave estructurada: "FNX-PRO-..."
  tenantId         String
  status           LicenseStatus @default(ACTIVE)
  maxDomains       Int           @default(1)
  maxActivations   Int           @default(1)
  issuedAt         DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  signatureHash    String // Hash HMAC/SHA256 para validación contra manipulación
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relaciones
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activations LicenseActivation[]

  @@index([tenantId])
  @@index([licenseKey])
  @@index([status])
  @@map("licenses")
}

model LicenseActivation {
  id                  String           @id @default(cuid())
  licenseId           String
  domainId            String
  status              ActivationStatus @default(ACTIVE)
  activatedAt         DateTime         @default(now())
  deactivatedAt       DateTime?
  instanceFingerprint String? // Huella criptográfica del entorno de ejecución
  createdAt           DateTime         @default(now())

  // Relaciones
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  domain  Domain  @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([licenseId, domainId])
  @@index([licenseId])
  @@index([domainId])
  @@index([status])
  @@map("license_activations")
}

// ============================================================================
// 5. SUSCRIPCIONES Y PAGOS (LIBRO MAYOR FINANCIERO INMUTABLE)
// ============================================================================

model Subscription {
  id                    String             @id @default(cuid())
  tenantId              String
  planId                String
  billingCycle          BillingCycle       @default(MONTHLY)
  status                SubscriptionStatus @default(TRIALING)
  recurringAmount       Decimal            @db.Decimal(10, 2)
  currency              String             @default("EUR")
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  trialEndsAt           DateTime?
  gatewaySubscriptionId String? // Referencia externa (e.g. sub_stripe_xxx)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relaciones
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([tenantId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id                     String         @id @default(cuid())
  tenantId               String
  subscriptionId         String?
  amount                 Decimal        @db.Decimal(10, 2)
  vatAmount              Decimal        @default(0.00) @db.Decimal(10, 2)
  currency               String         @default("EUR")
  status                 PaymentStatus  @default(PENDING)
  gateway                PaymentGateway @default(STRIPE)
  transactionId          String         @unique // Identificador pasarela (e.g. tx_stripe_xxx)
  verificationAuditToken String? // Código criptográfico de verificación bancaria
  invoiceNumber          String?        @unique
  paidAt                 DateTime?
  failureReason          String?
  metadataJson           String?        @db.Text
  createdAt              DateTime       @default(now())

  // Relaciones con protección contable inmutable: onDelete: Restrict
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([transactionId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// ============================================================================
// 6. AUDITORÍA INMUTABLE Y CONFIGURACIÓN GLOBAL
// ============================================================================

model AuditLog {
  id             String        @id @default(cuid())
  tenantId       String? // null = Acción global de infraestructura; not null = Acción en tenant
  actorId        String? // Usuario que ejecutó la acción
  actorEmail     String
  action         AuditAction
  severity       AuditSeverity @default(INFO)
  ipAddress      String?
  targetResource String // e.g. "tenant:tenant_moda_01", "license:FNX-PRO-99"
  details        String        @db.Text
  payloadJson    String?       @db.Text
  timestamp      DateTime      @default(now())

  // Relaciones con conservación obligatoria: onDelete: SetNull
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([severity])
  @@index([timestamp])
  @@map("audit_logs")
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "maintenance_mode", "enforce_verified_payments", "ssl_auto_provisioning"
  value       String   @db.Text
  description String?
  isEncrypted Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("platform_settings")
}

// ============================================================================
// 7. MÓDULO ECOMMERCE (TIENDA Y CATÁLOGO DE PRODUCTOS)
// ============================================================================

model ProductCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id           String        @id @default(cuid())
  tenantId     String
  categoryId   String?
  sku          String
  title        String
  slug         String
  description  String        @db.Text
  price        Decimal       @db.Decimal(10, 2)
  comparePrice Decimal?      @db.Decimal(10, 2)
  currency     String        @default("EUR")
  stock        Int           @default(0)
  isPublished  Boolean       @default(true)
  featured     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  orderItems StoreOrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model StoreOrder {
  id                    String                    @id @default(cuid())
  tenantId              String
  orderNumber           String
  idempotencyKey        String?                   @unique
  paymentVerificationId String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  shippingAddress       String?
  billingAddress        String?
  subtotal              Decimal                   @db.Decimal(10, 2)
  taxAmount             Decimal                   @default(0.00) @db.Decimal(10, 2)
  shippingCost          Decimal                   @default(0.00) @db.Decimal(10, 2)
  totalAmount           Decimal                   @db.Decimal(10, 2)
  currency              String                    @default("EUR")
  status                OrderStatus               @default(PENDING)
  paymentStatus         PaymentVerificationStatus @default(UNVERIFIED)
  notes                 String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  // Protección contable: no borrar pedidos si se intenta borrar un tenant directamente
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  StoreOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([status])
  @@index([customerEmail])
  @@index([idempotencyKey])
  @@map("store_orders")
}

model StoreOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productSku  String
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("store_order_items")
}

// ============================================================================
// 8. MÓDULO BLOG (PUBLICACIONES, CATEGORÍAS Y ETIQUETAS)
// ============================================================================

model BlogCategory {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  BlogPost[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("blog_categories")
}

model BlogPost {
  id              String        @id @default(cuid())
  tenantId        String
  categoryId      String?
  slug            String
  title           String
  excerpt         String?       @db.Text
  content         String        @db.Text
  coverImage      String?
  authorName      String        @default("Redacción")
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  viewsCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogTag {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime      @default(now())

  posts BlogPostTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("blog_tags")
}

model BlogPostTag {
  id        String   @id @default(cuid())
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
  @@map("blog_post_tags")
}

// ============================================================================
// 9. MÓDULO INMOBILIARIO (PROPIEDADES, IMÁGENES Y SOLICITUDES)
// ============================================================================

model RealEstateProperty {
  id              String            @id @default(cuid())
  tenantId        String
  slug            String
  title           String
  description     String            @db.Text
  operation       PropertyOperation @default(SALE)
  propertyType    PropertyType      @default(APARTMENT)
  price           Decimal           @db.Decimal(12, 2)
  currency        String            @default("EUR")
  surfaceM2       Decimal           @db.Decimal(8, 2)
  bedrooms        Int?
  bathrooms       Int?
  address         String?
  city            String
  province        String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  featuresJson    String?           @db.Text
  isPublished     Boolean           @default(false)
  isFeatured      Boolean           @default(false)
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images    PropertyImage[]
  inquiries PropertyInquiry[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@index([operation])
  @@index([propertyType])
  @@index([city])
  @@map("real_estate_properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  title      String?
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property RealEstateProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model PropertyInquiry {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  createdAt  DateTime @default(now())

  property RealEstateProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_inquiries")
}

// ============================================================================
// 10. MÓDULO DE SUBASTAS (LOTES, PUJAS Y ADJUDICACIÓN SEGURA)
// ============================================================================

model AuctionItem {
  id              String        @id @default(cuid())
  tenantId        String
  slug            String
  title           String
  description     String        @db.Text
  category        String?
  imageUrl        String?
  startingPrice   Decimal       @db.Decimal(12, 2)
  minBidIncrement Decimal       @db.Decimal(10, 2)
  currentBid      Decimal       @db.Decimal(12, 2)
  bidsCount       Int           @default(0)
  startsAt        DateTime
  endsAt          DateTime
  status          AuctionStatus @default(DRAFT)
  isPublished     Boolean       @default(false)
  sellerName      String?

  // Restricciones para evitar adjudicaciones duplicadas o sobre-adjudicación
  awardStatus     AwardStatus   @default(PENDING)
  winningBidId    String?       @unique
  winnerName      String?
  winnerEmail     String?
  awardedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bids       AuctionBid[] @relation("AuctionItemBids")
  winningBid AuctionBid?  @relation("WinningBid", fields: [winningBidId], references: [id], onDelete: Restrict)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@index([endsAt])
  @@index([tenantId, isPublished])
  @@map("auction_items")
}

model AuctionBid {
  id            String   @id @default(cuid())
  auctionItemId String
  bidderId      String?
  bidderName    String
  bidderEmail   String
  amount        Decimal  @db.Decimal(12, 2)
  isWinning     Boolean  @default(false)
  ipAddress     String?
  createdAt     DateTime @default(now())

  auctionItem AuctionItem  @relation("AuctionItemBids", fields: [auctionItemId], references: [id], onDelete: Cascade)
  wonAuction  AuctionItem? @relation("WinningBid")

  @@index([auctionItemId])
  @@index([bidderEmail])
  @@index([createdAt])
  @@map("auction_bids")
}

// ============================================================================
// 11. MÓDULO DE ANUNCIOS (CLASIFICADOS Y PERSONALES CON PRIVACIDAD)
// ============================================================================

model ClassifiedAd {
  id               String              @id @default(cuid())
  tenantId         String
  userId           String?
  slug             String
  title            String
  description      String              @db.Text
  category         String
  price            Decimal?            @db.Decimal(10, 2)
  condition        ClassifiedCondition @default(GOOD)
  location         String
  city             String?
  region           String?
  imagesJson       String?             @db.Text
  ownerName        String
  ownerPhone       String?
  ownerEmail       String?
  isPublished      Boolean             @default(false)
  moderationStatus ModerationStatus    @default(PENDING)
  moderationNotes  String?
  expiresAt        DateTime?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@index([moderationStatus])
  @@index([category])
  @@map("classified_ads")
}

model PersonalAd {
  id                  String           @id @default(cuid())
  tenantId            String
  userId              String?
  slug                String
  title               String
  description         String           @db.Text
  category            String
  age                 Int?
  city                String
  zone                String?
  interestsJson       String?          @db.Text
  imageUrl            String?
  // Contacto público no sensible
  publicContactAlias  String
  publicContactMethod String
  // Datos sensibles protegidos: NUNCA expuestos en API ni consultas públicas
  privateContactInfo  String?          @db.Text
  isVerified          Boolean          @default(false)
  isPublished         Boolean          @default(false)
  moderationStatus    ModerationStatus @default(PENDING)
  moderationNotes     String?
  expiresAt           DateTime?
  publishedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@index([moderationStatus])
  @@index([category])
  @@map("personal_ads")
}

// ============================================================================
// 12. CMS COMPARTIDO, LOCALIZACIÓN Y GESTIÓN DE CONTACTO
// ============================================================================

model CmsPage {
  id              String   @id @default(cuid())
  tenantId        String
  slug            String
  title           String
  content         String   @db.Text
  languageCode    String   @default("es")
  isPublished     Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@map("cms_pages")
}

model Language {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  isDefault Boolean  @default(false)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tenant_languages")
}

model TenantPlugin {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String
  name        String
  version     String   @default("1.0.0")
  category    String   @default("INTEGRATION")
  description String?
  isEnabled   Boolean  @default(false)
  configJson  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("tenant_plugins")
}

model TenantTheme {
  id           String   @id @default(cuid())
  tenantId     String
  slug         String
  name         String
  version      String   @default("1.0.0")
  isActive     Boolean  @default(false)
  previewColor String   @default("#3B82F6")
  description  String?
  settingsJson String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("tenant_themes")
}

model ContactInquiry {
  id         String        @id @default(cuid())
  tenantId   String
  name       String
  email      String
  phone      String?
  subject    String
  message    String        @db.Text
  status     InquiryStatus @default(NEW)
  replyNotes String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("contact_inquiries")
}

model ContentReport {
  id            String           @id @default(cuid())
  tenantId      String
  reporterEmail String
  reason        String
  details       String?          @db.Text
  targetType    ReportTargetType
  targetId      String
  status        ReportStatus     @default(PENDING)
  reviewNotes   String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([targetType, targetId])
  @@map("content_reports")
}
